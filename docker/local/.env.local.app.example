DEV_DB_URL=jdbc:mysql://mysql:3306/hirecore_member_server?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DEV_DB_USERNAME=hirecore_app
DEV_DB_PASSWORD=change-me

DEV_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dev.hirecore.co.kr

DEV_JWT_SECRET=change-me-to-a-long-random-string

DEV_KAKAO_CLIENT_ID=change-me
DEV_KAKAO_CLIENT_SECRET=change-me
DEV_KAKAO_CLIENT_REDIRECT_URL=https://dev-api.hirecore.co.kr/login/oauth2/code/kakao

DEV_OBJECT_STORAGE_REGION=ap-northeast-2
DEV_OBJECT_STORAGE_BUCKET=hirecore-member-server-dev
DEV_OBJECT_STORAGE_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
